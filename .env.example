DB_ROOT_PASSWORD=change_me
DB_APP_PASSWORD=change_me

# Optional: preferred PyPI index for building the backend image. Leave empty
# to let the build try pypi.org and then a few public mirrors automatically.
PIP_INDEX_URL=

# ---- Local session signing --------------------------------------------------
# Secret used to sign our own access-token JWTs (not Daydar's). Generate one
# with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me

# ---- Daydar SSO (mobile + OTP/password login, /me profile lookup) ----------
# Base URL and partner API key issued by Daydar. Login is unusable until both
# are set.
DIDAR_BASE_URL=
DIDAR_API_KEY=

# Host ports (unusual on purpose, bound to 127.0.0.1 only)
FRONTEND_PORT=47391
BACKEND_PORT=47392
DB_PORT=47393
BIND_HOST=127.0.0.1

# ---- Local development (defaults) ------------------------------------------
# App at http://localhost:47391, API at http://localhost:47392
#VITE_API_URL=http://localhost:47392
#VITE_BASE_PATH=/
#CORS_ALLOW_ORIGINS=http://localhost:47391,http://127.0.0.1:47391

# ---- Server: https://form.dayins.ir/health-analysis/ -----------------------
# Uncomment these on the server. The host nginx proxies the sub-path to the
# containers (see deploy/nginx-form.dayins.ir.conf).
#VITE_BASE_PATH=/health-analysis/
#VITE_API_URL=/health-analysis/api
#CORS_ALLOW_ORIGINS=https://form.dayins.ir
