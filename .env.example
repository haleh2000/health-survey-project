# Copy to .env and adjust if needed. Defaults work out of the box.

# Host ports
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Base URL the browser uses for API calls. Keep "/api" so nginx proxies to
# the backend container. Set to a full URL only if the API lives elsewhere.
VITE_API_URL=/api

# Extra origins allowed to call the backend directly (comma separated).
CORS_ALLOW_ORIGINS=http://localhost:8080
