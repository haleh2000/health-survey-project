DB_ROOT_PASSWORD=change_me
DB_APP_PASSWORD=change_me

# Optional: PyPI mirror used while building the backend image
# (pypi.org is blocked/slow on some networks).
PIP_INDEX_URL=https://mirror-pypi.runflare.com/simple

# ---- Local development (defaults) ------------------------------------------
# App at http://localhost:5173, API at http://localhost:8000
#VITE_API_URL=http://localhost:8000
#VITE_BASE_PATH=/
#CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Server: https://form.dayins.ir/health-analysis/ -----------------------
# Uncomment these on the server. The host nginx proxies the sub-path to the
# containers (see deploy/nginx-form.dayins.ir.conf).
#VITE_BASE_PATH=/health-analysis/
#VITE_API_URL=/health-analysis/api
#CORS_ALLOW_ORIGINS=https://form.dayins.ir
#FRONTEND_PORT=5173
#BACKEND_PORT=8000
#DB_PORT=3307
#BIND_HOST=127.0.0.1
